# انسخ الملف ده باسم .env وعدّل القيم (أو شغّل: npm run setup عشان يتعمل تلقائياً بقيم آمنة)
# ملف .env ممنوع يترفع على GitHub (موجود في .gitignore)

NODE_ENV=development
PORT=3000

# سر التوقيع الخاص بـ JWT — لازم 32 حرف عشوائي على الأقل. مثال لتوليده:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# بيانات الأدمن الافتراضي (بتتنشئ أول مرة السيرفر يشتغل لو مفيش أدمن). كلمة المرور 8 أحرف على الأقل
ADMIN_USER=admin
ADMIN_PASSWORD=

# مكان قاعدة البيانات والصور المرفوعة.
# على Render/Railway لازم يشاوروا على Persistent Disk/Volume (مثال: /var/data/turbowash.db و /var/data/uploads)
DB_PATH=./data/turbowash.db
UPLOADS_DIR=./uploads

# المنطقة الزمنية المستخدمة في حساب "النهارده" و"الشهر"
APP_TIMEZONE=Africa/Cairo

# اختياري: لو بتجرب NODE_ENV=production على http محلي (من غير HTTPS) خليها false
# COOKIE_SECURE=false
